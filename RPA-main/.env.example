# Copie somente se ainda não existir .env. Nenhuma credencial real neste arquivo.
TECH_DATA_DIR=data
WEB_HOST=127.0.0.1
WEB_PORT=5000
WEB_URL=http://127.0.0.1:5000
# Para celular, use IPv4 do PC e WEB_HOST=0.0.0.0 (rede privada).
PUBLIC_BASE_URL=http://127.0.0.1:5000
# Vazios: senha e chave aleatórias são geradas em data/ na primeira execução.
ADMIN_PASSWORD=
SECRET_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Destinatários autorizados para teste. Vazios: os destinatários do cadastro.
TEST_EMAIL=
TEST_PHONE=
BROWSER=chrome
# Deixe vazios para usar Selenium Manager; informe driver local se estiver offline.
BROWSER_DRIVER=
BROWSER_BINARY=
WHATSAPP_SEND_IMAGE=assets/whatsapp_send.png
WHATSAPP_CONFIDENCE=0.90
WAIT_TIMEOUT=40
